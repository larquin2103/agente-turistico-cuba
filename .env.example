# ─────────────────────────────────────────────────
# AGENTE TURÍSTICO CUBA — Plantilla de configuración
# Copia este archivo como .env y rellena los valores
# ─────────────────────────────────────────────────

# Token del bot de Telegram (obtenido de @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Clave secreta para la API interna (elige una cadena aleatoria segura)
API_KEY=your_secret_api_key_here

# Ruta a la base de datos ChromaDB
DB_PATH=./db

# URL de la API local FastAPI
API_URL=http://localhost:8000

# Proxy corporativo (dejar vacío si no se usa proxy)
PROXY_URL=

# Groq API — clave gratuita en https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Modelo de embeddings local (sin API key, se descarga ~91MB la primera vez)
EMBED_MODEL=BAAI/bge-small-en-v1.5
