# ─────────────────────────────────────────────────
# AGENTE TURÍSTICO CUBA — Plantilla de configuración
# Copia este archivo como .env y rellena los valores
# ─────────────────────────────────────────────────

# Token del bot de Telegram (obtenido de @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Clave secreta para la API interna (elige una cadena aleatoria segura)
API_KEY=your_secret_api_key_here

# Ruta a la base de datos ChromaDB
DB_PATH=./db

# URL de la API local FastAPI
API_URL=http://localhost:8000

# Proxy corporativo (dejar vacío si no se usa proxy)
PROXY_URL=

# Configuración de Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
