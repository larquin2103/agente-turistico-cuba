{
  "name": "saas-rag-promo-video",
  "version": "1.0.0",
  "description": "Video promocional 2:30 min - SaaS Agente IA con RAG (WhatsApp + Telegram)",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "build": "remotion render PromoVideo out/promo-video.mp4",
    "build:reels": "remotion render PromoVideoVertical out/promo-reels.mp4",
    "build:all": "npm run build && npm run build:reels",
    "upgrade": "remotion upgrade",
    "still": "remotion still PromoVideo out/poster.png --frame=0"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.250",
    "@remotion/cli": "^4.0.250",
    "@remotion/google-fonts": "^4.0.250",
    "@remotion/renderer": "^4.0.250",
    "@remotion/shapes": "^4.0.250",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.250"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
